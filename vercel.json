{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/projects",
      "destination": "/work",
      "permanent": true
    },
    {
      "source": "/projects/web",
      "destination": "/work/websites",
      "permanent": true
    },
    {
      "source": "/projects/ai",
      "destination": "/work/ai-video",
      "permanent": true
    },
    {
      "source": "/projects/design",
      "destination": "/work/design",
      "permanent": true
    },
    {
      "source": "/projects/data",
      "destination": "/data",
      "permanent": true
    },
    {
      "source": "/(skills|tools|experience)",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/learning",
      "destination": "/data",
      "permanent": true
    },
    {
      "source": "/certifications",
      "destination": "/certificates",
      "permanent": true
    },
    {
      "source": "/certificates/:slug",
      "destination": "/certificates",
      "permanent": true
    },
    {
      "source": "/landing",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/work/(websites|ai-video|design|data)",
      "destination": "/work"
    }
  ],
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' cdn.credly.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com; font-src fonts.gstatic.com data:; img-src 'self' data: *.credly.com; media-src 'self' res.cloudinary.com; frame-src 'self' www.credly.com www.youtube-nocookie.com; connect-src 'self' *.vercel-insights.com; form-action 'self' formsubmit.co; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}